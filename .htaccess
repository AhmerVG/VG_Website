# vgreen.com.pk (Apache). Added 27 Sep 2026.
#
# 1. Caching. Everything under /assets/ carries a content hash in its filename (main-CMwPpEdk.js),
#    so a changed file always gets a new name and the old name can be cached for a year. Photos
#    under /img/ change rarely and are re-exported under a new name when they do. HTML files are
#    the entry points and must always be re-checked, or a visitor keeps an old page pointing at
#    chunks that no longer exist after a deploy.
# 2. Security headers. None were set before this file.
#
# If the host does not load mod_headers or mod_expires the IfModule blocks are skipped silently
# and the site still serves; nothing here can break a page.

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|avif|svg|ico|gif)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Content-Security-Policy is deliberately not set: the pages use inline scripts and styles and
  # load fonts from Google, so a strict policy needs a nonce scheme first. Add it with the fonts
  # self-hosted.
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# gzip is already on at the host; this only covers a server that lost the setting.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml
</IfModule>
